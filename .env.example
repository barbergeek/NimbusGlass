# Copy to .env and fill in. Never commit the real .env file.

# Port the Node.js server binds to (0.0.0.0)
PORT=3000

# OpenWeatherMap API key - https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Admin console basic auth (leave blank to disable auth on the flat local VLAN)
ADMIN_USER=
ADMIN_PASS=

# Backlight used for overnight dimming (a name under /sys/class/backlight).
# Leave blank to use the first one found; with none, the display dims with
# an on-screen overlay instead.
BACKLIGHT_DEVICE=
